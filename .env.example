# =====================================================================
# Loan - environment settings
# Copy this file to .env and fill it in. Never commit .env.
#
# Writing values:
#   - Quote any value that contains spaces or #  (an unquoted # starts a comment).
#   - $ is expanded even inside quotes: write a literal $ as \$  e.g. "pa\$\$word"
#   - NEXT_PUBLIC_* values are built into the browser code: change them, then rebuild.
# =====================================================================


# ---------------------------------------------------------------------
# Database (SQL Server, through Prisma) - required
# Put a password containing ; = { or } inside braces: password={my;pass}
# ---------------------------------------------------------------------
DATABASE_URL="sqlserver://localhost:1433;database=Loan;user=loan_app;password=change-me;encrypt=true;trustServerCertificate=true"


# ---------------------------------------------------------------------
# Sessions - required
# A long random secret that signs the login cookies. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it logs everybody out.
# ---------------------------------------------------------------------
SESSION_SECRET=change-me-to-a-long-random-value


# ---------------------------------------------------------------------
# Mini-app login - required
# Where the super-app's token is checked when a customer opens the mini-app
# (also used by the payment callback).
# ---------------------------------------------------------------------
TOKEN_VALIDATION_API_URL=https://<super-app-host>/<token-validation-path>


# ---------------------------------------------------------------------
# Customer data: the Nibtera Data API (the Python API)
# Set the URL and Loan reads customer info and statements from it. Leave it
# empty and Loan uses the bank middleware below (EXTERNAL_CUSTOMER_INFO_URL ...).
# The URL ends with /nibtera-loan: Loan adds /get-customer-info or
# /get-account-statement. The user and password are the API_USERNAME and
# API_PASSWORD the data API was installed with.
# ---------------------------------------------------------------------
CUSTOMER_DATA_API_URL=http://127.0.0.1:8000/nibtera-loan
CUSTOMER_DATA_API_USERNAME=nibtera
CUSTOMER_DATA_API_PASSWORD=change-me

# Statement figures for scoring. Unset = on whenever CUSTOMER_DATA_API_URL is set.
# STATEMENT_FIGURES_ENABLED=true
# true = also ask for opening/closing balances. Each one sums the account's whole
# history in ODS (minutes per account), so leave it false.
STATEMENT_OPENING_BALANCE=false
# At most this many statement fetches at once (default 3); the rest wait in line.
# STATEMENT_FETCH_CONCURRENCY=3
# Safety limit on how many may wait (default 1000).
# STATEMENT_FETCH_QUEUE=1000


# ---------------------------------------------------------------------
# Bank middleware (WSO2) - one login for all of these
# ---------------------------------------------------------------------
EXTERNAL_API_USERNAME=change-me
EXTERNAL_API_PASSWORD=change-me
# The accounts of a phone number (account picker, and the check that an account
# belongs to the borrower before linking, scoring or paying out)
EXTERNAL_API_URL=http://<middleware-host>:8280/<get-accounts-path>
# Paying out a loan
EXTERNAL_DISBURSEMENT_URL=http://<middleware-host>:8280/<disbursement-path>
# Provider fund distribution
EXTERNAL_DISTRIBUTION_URL=http://<middleware-host>:8280/nibtera-loan/distribution
# Used only while CUSTOMER_DATA_API_URL is empty, and by scripts/backfill-branchcodes.ts
EXTERNAL_CUSTOMER_INFO_URL=http://<middleware-host>:8280/nibtera-loan/get-customer-info
EXTERNAL_STATEMENT_URL=http://<middleware-host>:8280/nibtera-loan/get-account-statement

# The provider id sent with every disbursement, whatever the loan's provider (default PRO0001)
FORCE_PROVIDER_ID=PRO0001


# ---------------------------------------------------------------------
# Repayments through the NIB payment gateway - these four are required for payments
# ---------------------------------------------------------------------
NIB_PAYMENT_URL=https://<payment-gateway-host>/<initiate-path>
NIB_PAYMENT_KEY=change-me
# The name shown to the customer
COMPANY_NAME="<Company Name>"
# This app's payment callback, as the gateway can reach it
CALLBACK_URL=https://<this-app-host>/api/payment-callback
# Repayments are paid into the loan provider's Collection Account (Edit Provider).
# Optional: the account used for a provider that has no Collection Account set.
# ACCOUNT_NO=<collection-account-number>


# ---------------------------------------------------------------------
# SMS - without it, no SMS is sent (the attempt is logged)
# ---------------------------------------------------------------------
SMS_URL=http://<sms-gateway-host>/<send-path>


# ---------------------------------------------------------------------
# Core banking NPL reporting
# ---------------------------------------------------------------------
# Where NPL notifications are sent (default http://localhost:8080/api/v1/notification)
CBS_NPL_BASE_URL=http://<cbs-host>:8080/api/v1/notification
# Either a bearer token, or a user name and password
CBS_NPL_AUTH_TOKEN=
CBS_NPL_USERNAME=
CBS_NPL_PASSWORD=
# The token core banking must send when it calls /api/cbs/notifications/credit
# (Authorization: Bearer <token>, or an x-cbs-token header)
CBS_NPL_INBOUND_TOKEN=change-me
# CBS_DEFAULT_PROVIDER_ID=PRO0001
# CBS_NPL_BULK_MAX_ACCOUNTS=1000
# CBS_NPL_TIMEOUT_MS=20000
# Minutes between retries of failed NPL uploads by the worker (default 5)
# NPL_RETRY_INTERVAL_MINUTES=5


# ---------------------------------------------------------------------
# Lersha (default https://dev-api-integration.lersha.com/api/v1)
# ---------------------------------------------------------------------
# LERSHA_API_BASE_URL=https://<lersha-host>/api/v1


# ---------------------------------------------------------------------
# Display
# ---------------------------------------------------------------------
# Tax that core banking deducts at payout, in percent ("1" = 1%). Shown to the
# customer only; 0 or unset hides the line. Built in: rebuild after changing.
NEXT_PUBLIC_CORE_DEDUCTED_TAX_RATE=1


# ---------------------------------------------------------------------
# Files (defaults: the logs and uploads folders in the app folder)
# ---------------------------------------------------------------------
# LOG_DIR=C:\Loan\logs
# UPLOADS_DIR=C:\Loan\uploads
# Audit entries the database refused (e.g. during an outage) are kept here as
# audit-fallback.jsonl and replayed automatically once writes succeed again.
# Defaults to LOG_DIR. Must survive restarts and be shared by the app and worker.
# AUDIT_FALLBACK_DIR=C:\Loan\logs


# ---------------------------------------------------------------------
# Development only - never in production
# true = /api/dev-login?phone=...&account=... opens the mini-app as any phone, and
# account ownership is not checked while EXTERNAL_API_URL is empty. Ignored when
# NODE_ENV=production.
# ---------------------------------------------------------------------
MINIAPP_TEST_LOGIN=false
