      "name": "1. Core → Lending · Account activity notifications",
      "item": [
        {
          "name": "Credit — money into the account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Acknowledged with 200', () => pm.response.to.have.status(200));\npm.test('Acknowledgement carries a notificationId', () => {\n    pm.expect(pm.response.json()).to.have.property('notificationId');\n});\n\n// Remember this delivery so the replay request can resend it verbatim.\nconst body = pm.response.json();\npm.collectionVariables.set('lastExternalReference', pm.collectionVariables.get('externalReference'));\nif (body.notificationId) pm.collectionVariables.set('lastNotificationId', body.notificationId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalReference\": \"{{externalReference}}\",\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"transactionType\": \"CREDIT\",\n  \"amount\": {{creditAmount}},\n  \"currency\": \"{{currency}}\",\n  \"accountCategory\": \"{{accountCategory}}\",\n  \"notifiedAt\": \"{{notifiedAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{lendingBaseUrl}}/api/cbs/notifications/credit",
              "host": [
                "{{lendingBaseUrl}}"
              ],
              "path": [
                "api",
                "cbs",
                "notifications",
                "credit"
              ]
            },
            "description": "A deposit, transfer in, or any other inbound movement on a monitored account.\n\n`currentBalance` is the balance **after** the credit has landed. Send it post-settlement: a pre-credit snapshot understates what is on the account and makes the notification look smaller than the movement really was."
          },
          "response": [
